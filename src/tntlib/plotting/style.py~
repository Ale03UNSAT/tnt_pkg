"""
Matplotlib style configuration for the AP scientific plotting package.

This module defines the standard Matplotlib rcParams used by the AP research
group for scientific figures and publications.
"""

import matplotlib as mpl


# Conversion factor
MM_TO_PT = 72.0 / 25.4


# ---------------------------------------------------------------------------
# AP Matplotlib style
# ---------------------------------------------------------------------------

AP_RCPARAMS = {
    # ---------- Figure ----------
    "savefig.format": "eps",
    "savefig.bbox": "tight",

    # ---------- Font ----------
    "font.family": "sans-serif",
    "font.sans-serif": ["Helvetica", "Arial", "Nimbus Sans"],
    "mathtext.fontset": "stixsans",

    # ---------- Font sizes ----------
    "font.size": 34,
    "axes.titlesize": 34,
    "axes.labelsize": 34,
    "xtick.labelsize": 34,
    "ytick.labelsize": 34,
    "legend.fontsize": 40,
    "figure.titlesize": 34,

    # ---------- Axes ----------
    "axes.linewidth": 2.0,
    "axes.grid": False,

    # ---------- Lines ----------
    "lines.linewidth": 1.0 * MM_TO_PT,
    "lines.markersize": 10,

    # ---------- EPS / PS text handling ----------
    "ps.fonttype": 42,

    # ---------- Major ticks ----------
    "xtick.major.size": 10,
    "ytick.major.size": 10,
    "xtick.major.width": 2.0,
    "ytick.major.width": 2.0,
    "xtick.major.pad": 8,
    "ytick.major.pad": 8,

    # ---------- Minor ticks ----------
    "xtick.minor.size": 6,
    "ytick.minor.size": 6,
    "xtick.minor.width": 1.5,
    "ytick.minor.width": 1.5,
    "xtick.minor.visible": True,
    "ytick.minor.visible": True,
}


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def set_style():
    """
    Apply the standard AP Matplotlib style.

    This function modifies ``matplotlib.rcParams`` globally.
    """
    mpl.rcParams.update(AP_RCPARAMS)


def reset_style():
    """
    Reset Matplotlib to its default rcParams.
    """
    mpl.rcdefaults()


def get_style():
    """
    Return a copy of the AP Matplotlib style configuration.

    Returns
    -------
    dict
        Dictionary containing the AP rcParams.
    """
    return AP_RCPARAMS.copy()


def print_style():
    """
    Print the AP Matplotlib style configuration.

    The values shown are the values defined by AP_RCPARAMS, not necessarily
    the values currently active in Matplotlib.
    """
    print("AP Matplotlib style")
    print("-" * 60)

    for key, value in AP_RCPARAMS.items():
        print(f"{key:<25} = {value}")
